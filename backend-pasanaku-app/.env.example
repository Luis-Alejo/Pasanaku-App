NODE_ENV=development
PORT=3000

# DB
DATABASE_URL=postgres://postgres:password@localhost:5432/pasanaku
DB_SSL=false

# JWT
JWT_SECRET=openssl rand -base64 48
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=openssl rand -hex 32

# Pa la demo
KYC_AUTO_APPROVE=true

# Stellar y Testnet
STELLAR_NETWORK=TESTNET
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# stellar keys generate admin --network testnet --fund
STELLAR_ADMIN_SECRET=stellar keys show admin

# USDC de Testnet
USDC_ASSET_CODE=USDC
USDC_ISSUER=stellar keys address admin
USDC_CONTRACT_ID=stellar contract asset deploy --asset USDC:<ADMIN_PUBLIC> --source admin --network testnet

# Contracts desplegados en Testnet
REPUTATION_REGISTRY_ID=stellar contract deploy --wasm reputation_registry.wasm --source admin --network testnet -- --administrator <ADMIN_PUBLIC>
PASANAKU_WASM_HASH=stellar contract upload --wasm pasanaku.wasm --source admin --network testnet

SCHEDULER_ENABLED=true

POLLAR_MOCK=true
POLLAR_MOCK_MODE=true