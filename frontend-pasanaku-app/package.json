{
  "name": "frontend-pasanaku-app",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "npm run eslint && npm run typecheck:e2e && npm run prettier -- --check",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,html}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "test:e2e": "playwright test",
    "codegen": "graphql-codegen",
    "start:real": "ng serve --configuration real",
    "start:phone": "ng serve --configuration real --host 0.0.0.0",
    "start:cloud": "ng serve --configuration cloud --host 0.0.0.0"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@apollo/client": "^4.3.8",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/poppins": "^5.3.0",
    "@ionic/angular": "^9.0.0",
    "apollo-angular": "^14.2.0",
    "graphql": "^16.15.0",
    "ionicons": "^8.1.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@angular/language-service": "22.2.6",
    "@capacitor/cli": "8.6.2",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-apollo-angular": "^6.0.0",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.1.0"
  },
  "prettier": "@ionic/prettier-config",
  "description": "An Ionic project",
  "engines": {
    "node": ">=20.19"
  }
}
